# Можна нічого не заповнювати: при першому запуску бот сам спитає токен і збереже його сюди,
# а після /owner сам допише OWNER_ID.
BOT_TOKEN=
OWNER_ID=

# Необов'язкові налаштування
MAX_VOTES=7             # голосів на номінацію
TAP_GUARD_SECONDS=5     # повторний тап на той самий костюм за N с ігнорується
REQUIRE_MEMBER=1        # 1 = голосують лише підписники каналу, 0 = будь-хто
MAX_REPLACES=3          # скільки разів учасник може замінити фото
SIMILAR_DIST=6          # чутливість до схожих фото (0..64, менше = суворіше)
BURST_PER_MIN=8         # стільки голосів за 1 хв за один костюм = сплеск у /audit
POST_INTERVAL=3.5       # мінімум секунд між постами в канал
CHANNEL_PER_MIN=19      # не більше стількох повідомлень у канал за хвилину (ліміт Telegram 20)
SEND_RATE=25            # швидкість розсилок /broadcast і /remind, повідомлень за секунду (ліміт ~30)
SAVE_SECONDS=2          # як часто дані скидаються на диск
LOCAL_BACKUP_MINUTES=1  # копія в папку backups/
VOTE_BACKUP_MINUTES=3   # бекап власнику в Telegram, поки йде голосування
BACKUP_MINUTES=15       # ...і коли голосування закрите
LOG_MAX_KB=1024         # розмір одного файлу bot.log, КБ
LOG_BACKUPS=5           # скільки старих логів тримати (bot.log.1 … bot.log.5)
